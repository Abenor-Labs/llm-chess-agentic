# Postgres connection (required). For local dev: `docker compose up -d` gives
# postgresql://chess:chess@localhost:5434/chess
DATABASE_URL=postgresql://...

# Integration tests (`pnpm test`) run against this database when set — use a
# throwaway database, it is truncated between tests. Put it in .env.test.
# TEST_DATABASE_URL=postgresql://...

# AI provider keys — OPTIONAL. Keys are bring-your-own: users paste theirs in
# Settings (kept in their browser) and they are sent only with the matches that
# need them. Set them here only for self-hosting, as a server-wide fallback.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=        # models with other prefixes route via Vercel AI Gateway

# Encrypts per-match keys at rest in the games table (recommended in production).
# ENCRYPTION_KEY=
