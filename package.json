    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate-match.ts",
    "healthcheck": "tsx scripts/model-healthcheck.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.50",
    "@ai-sdk/google": "^2.0.44",
    "@ai-sdk/groq": "2.0.57",
    "@ai-sdk/openai": "^2.0.74",
    "ai": "^5.0.104",
    "chess.js": "^1.4.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "next": "16.2.10",
    "postgres": "^3.4.7",
    "react": "19.2.0",
    "react-chessboard": "^5.8.6",
    "react-dom": "19.2.0",
    "stockfish": "^17.1.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
